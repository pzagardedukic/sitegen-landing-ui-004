  "about": {
    "aboutType": "ABOUT_COMPANY",
    "sectionName": "O salonu",
    "text": "Mirna je salon s štirimi sobami za masažo in nego obraza ter kotičkom za manikuro. Termine razporejamo z dvajsetminutnim razmikom, zato nihče ne čaka v čakalnici in nobena obravnava se ne konča prehitro. Uporabljamo naravno kozmetiko slovenskih in evropskih proizvajalcev.",
    "establishedYear": 2015,
    "items": [
      {
        "text": "Vsak obisk se začne s kratkim pogovorom: kaj vas teži, kaj koži ustreza in česa ne želite. Na podlagi tega terapevtka izbere olja, pritisk in trajanje.",
        "image": {
          "id": "about-ritual",
          "file": "/images/onas-ritual.webp"
        }
      },
      {
        "text": "Sobe so zvočno ločene, ogrevane mize pa pripravimo pred vašim prihodom. Brisače in ogrinjala peremo sami, brez odišavljenih mehčalcev.",
        "image": {
          "id": "about-room",
          "file": "/images/onas-prostor.webp"
        }
      },
      {
        "text": "Po obravnavi ostanete v sobi za sprostitev, kolikor želite. Čaj iz domačih zelišč in kozarec vode sta vedno pripravljena.",
        "image": {
          "id": "about-welcome",
          "file": "/images/onas-sprejem.webp"
        }
      }
    ]
  },
