  "services": {
    "text": "Three kinds of visit, from a massage to well-kept nails. Length and price are agreed up front, with no extras added at the end.",
    "items": [
      {
        "title": "Massage",
        "text": "Classic, relaxing, sports and lymphatic massage, and hot stones, from 30 to 90 minutes.",
        "features": [
          "A warmed massage table",
          "Oils of your choice",
          "Pressure adjusted to you",
          "Relaxation room afterwards"
        ],
        "image": {
          "id": "service-massage",
          "file": "/images/storitev-masaze.webp"
        }
      },
      {
        "title": "Facials",
        "text": "Cleansing, hydration and rejuvenation with natural skincare suited to your skin type.",
        "features": [
          "Skin analysis before the treatment",
          "Natural, vegan skincare",
          "Face and décolleté massage",
          "A written routine for home"
        ],
        "image": {
          "id": "service-facial",
          "file": "/images/storitev-obraz.webp"
        }
      },
      {
        "title": "Manicure and pedicure",
        "text": "Classic and spa manicures, gel, long-lasting polish and medical pedicures in a separate corner.",
        "features": [
          "Sterilised tools for every client",
          "More than 120 polish shades",
          "Paraffin bath",
          "Free touch-up within 5 days"
        ],
