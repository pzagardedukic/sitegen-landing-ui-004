  "about": {
    "aboutType": "ABOUT_COMPANY",
    "sectionName": "About the salon",
    "text": "Mirna is a salon with four rooms for massage and facials and a corner for manicures. Appointments are spaced twenty minutes apart, so nobody waits in the lobby and no treatment is rushed to the end. We use natural skincare from Slovenian and European makers.",
    "establishedYear": 2015,
    "items": [
      {
        "text": "Every visit starts with a short conversation: what is bothering you, what suits your skin and what you would rather avoid. Your therapist then chooses the oils, pressure and length.",
        "image": {
          "id": "about-ritual",
          "file": "/images/onas-ritual.webp"
        }
      },
      {
        "text": "The rooms are soundproofed and the tables are warmed before you arrive. We launder the towels and robes ourselves, without scented softeners.",
        "image": {
          "id": "about-room",
          "file": "/images/onas-prostor.webp"
        }
      },
      {
        "text": "After your treatment you can stay in the relaxation room for as long as you like. Herbal tea and a glass of water are always ready.",
        "image": {
          "id": "about-welcome",
          "file": "/images/onas-sprejem.webp"
        }
      }
    ]
  },
